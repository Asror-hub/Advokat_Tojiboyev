# Copy this file to ".env" and set your own values. Never commit ".env".

# Password for the admin panel (/admin). Use 12+ characters.
# If left empty, a random password is generated on the first start, shown once in the
# console, and only its hash is stored (server/data/admin-password.hash).
ADMIN_PASSWORD=

# Port for the production server (npm start)
PORT=3000

# Set to 1 when the site runs behind a reverse proxy or a hosting platform
# (Nginx, Caddy, Cloudflare, Render, Railway, ...). Needed for correct visitor
# addresses (login limits) and HTTPS detection.
TRUST_PROXY=

# Set to true to redirect http:// visitors to https:// (needs TRUST_PROXY behind a proxy).
FORCE_HTTPS=
