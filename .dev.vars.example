# Local secrets for `npm run dev`. Copy this file to ".dev.vars" and set your own values.
# Never commit ".dev.vars". On the live site the same two values are Cloudflare secrets
# (see DEPLOY.md).

# Password for the admin panel (/admin). Use 12+ characters.
ADMIN_PASSWORD=

# Any long random text. It is used to sign the admin login token.
ADMIN_SECRET=

# Contact form -> lawyer's app. Supabase project URL and the SERVICE ROLE key (Supabase >
# Project Settings > API). The service key is powerful: keep it only here and in Cloudflare
# secrets, never in the website code or in the Company app.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
